// crmPlus — Aşama 1 veri modeli
// Kurallar: docs/01 (roller), docs/02 (alanlar), docs/03 (sonuç kodları), docs/04 (izin), docs/07 (saklama)
// Finans tabloları ayrı "finance", personel/puantaj tabloları ayrı "hr" şemasında tutulur; çağrı/segment servisleri bu şemalara erişmez.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "finance", "hr"]
}

// ───────────────────────── Kullanıcı, rol, oturum ─────────────────────────

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED

  @@schema("public")
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  name               String
  passwordHash       String
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true)
  mfaSecretEnc       String? // şifreli TOTP sırrı
  mfaEnabledAt       DateTime?
  failedLogins       Int        @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  languages          String[]   @default(["tr"]) // temsilcinin konuştuğu diller
  extension          String? // santral dahili numarası
  teamId             String?
  team               Team?      @relation("TeamMembers", fields: [teamId], references: [id])
  ledTeams           Team[]     @relation("TeamLeader")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  disabledAt         DateTime?

  roles         UserRole[]
  sessions      Session[]
  recoveryCodes MfaRecoveryCode[]
  ownedGuests   Guest[]           @relation("GuestOwner")
  tasks         Task[]            @relation("TaskAssignee")
  calls         Call[]
  callbacks     Callback[]        @relation("CallbackAssignee")
  statusLogs    AgentStatusLog[]

  @@index([teamId])
  @@schema("public")
}

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  leaderId  String?
  leader    User?    @relation("TeamLeader", fields: [leaderId], references: [id])
  members   User[]   @relation("TeamMembers")
  createdAt DateTime @default(now())

  @@schema("public")
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique // ör. "agent", "team_lead"
  name        String
  description String?
  system      Boolean          @default(false) // seed ile gelen roller silinemez
  permissions RolePermission[]
  users       UserRole[]

  @@schema("public")
}

model RolePermission {
  roleId     String
  permission String // src/server/auth/permissions.ts içindeki anahtarlar
  scope      String @default("own") // own | team | all
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@schema("public")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@schema("public")
}

model Session {
  id            String    @id // rastgele 32 bayt, yalnız SHA-256 özeti saklanır
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaVerified   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  ip            String?
  userAgent     String?
  revokedAt     DateTime?
  elevatedUntil DateTime? // gerekçeli acil erişim / dinleme izni

  @@index([userId])
  @@schema("public")
}

model MfaRecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?

  @@index([userId])
  @@schema("public")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@schema("public")
}

// ───────────────────────── Denetim ve erişim kayıtları ─────────────────────────
// AuditLog ve AccessLog değiştirilemez: migration ile UPDATE/DELETE tetikleyicisi engellenir.

model AuditLog {
  id       BigInt   @id @default(autoincrement())
  at       DateTime @default(now())
  actorId  String?
  action   String // ör. "guest.update", "role.assign"
  entity   String?
  entityId String?
  reason   String?
  diff     Json?
  ip       String?

  @@index([entity, entityId])
  @@index([actorId, at])
  @@schema("public")
}

model AccessLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  actorId    String?
  action     String // view | reveal | export | listen | denied
  resource   String
  resourceId String?
  reason     String?
  meta       Json?
  ip         String?

  @@index([actorId, at])
  @@index([action, at])
  @@schema("public")
}

enum AlertSeverity {
  P1
  P2
  P3
  P4

  @@schema("public")
}

model AccessAlert {
  id         String        @id @default(cuid())
  at         DateTime      @default(now())
  rule       String
  severity   AlertSeverity
  actorId    String?
  detail     Json?
  resolvedAt DateTime?
  resolvedBy String?
  resolution String?

  @@schema("public")
}

// ───────────────────────── Misafir ─────────────────────────

model Guest {
  id           String    @id @default(cuid())
  crmNo        Int       @unique @default(autoincrement()) // görünen CRM ID: CRM-000123
  firstName    String
  lastName     String
  language     String    @default("tr")
  timezone     String    @default("Europe/Istanbul")
  country      String?
  city         String?
  birthYear    Int?
  vipLevel     String?
  tags         String[]  @default([])
  ownerId      String?
  owner        User?     @relation("GuestOwner", fields: [ownerId], references: [id])
  fieldSources Json? // alan -> { sourceId, at }
  anonymizedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  phones       GuestPhone[]
  emails       GuestEmail[]
  externalIds  GuestExternalId[]
  consents     ConsentRecord[]
  blocks       ContactBlock[]
  notes        GuestNote[]
  interactions Interaction[]
  tasks        Task[]
  calls        Call[]
  callbacks    Callback[]
  history      FieldHistory[]
  profile      GuestProfile?
  documents    GuestDocument[]

  @@index([lastName, firstName])
  @@index([ownerId])
  @@schema("public")
}

enum PhoneFormatStatus {
  VALID
  INVALID
  COUNTRY_MISMATCH

  @@schema("public")
}

enum PhoneReachability {
  UNVERIFIED
  REACHED
  UNREACHED
  UNREACHABLE

  @@schema("public")
}

enum PhoneOwnership {
  CONFIRMED
  UNCONFIRMED
  DISPUTED

  @@schema("public")
}

model GuestPhone {
  id               String            @id @default(cuid())
  guestId          String
  guest            Guest             @relation(fields: [guestId], references: [id], onDelete: Cascade)
  e164Enc          String // şifreli E.164
  phoneHash        String // HMAC blind index — unique DEĞİL (aynı numara birden çok kişide olabilir)
  masked           String // ör. "+90 532 *** ** 18"
  country          String?
  lineType         String? // MOBILE | FIXED_LINE | VOIP | UNKNOWN …
  isPrimary        Boolean           @default(false)
  formatStatus     PhoneFormatStatus @default(VALID)
  reachability     PhoneReachability @default(UNVERIFIED)
  ownership        PhoneOwnership    @default(UNCONFIRMED)
  lastReachedAt    DateTime?
  lastFailedAt     DateTime?
  consecutiveFails Int               @default(0)
  lastCheckedAt    DateTime?
  createdAt        DateTime          @default(now())
  checks           PhoneCheck[]

  @@index([phoneHash])
  @@index([guestId])
  @@schema("public")
}

model PhoneCheck {
  id      String     @id @default(cuid())
  phoneId String
  phone   GuestPhone @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  kind    String // FORMAT | LINE_TYPE | REACHABILITY
  result  String
  source  String // libphonenumber | call | sms_dlr | hlr:<provider>
  at      DateTime   @default(now())
  raw     Json?

  @@index([phoneId, at])
  @@schema("public")
}

model GuestEmail {
  id        String  @id @default(cuid())
  guestId   String
  guest     Guest   @relation(fields: [guestId], references: [id], onDelete: Cascade)
  emailEnc  String
  emailHash String
  masked    String
  isPrimary Boolean @default(false)

  @@index([emailHash])
  @@index([guestId])
  @@schema("public")
}

model GuestExternalId {
  id      String @id @default(cuid())
  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)
  source  String // casino / iş ortağı kodu
  value   String

  @@unique([source, value])
  @@index([guestId])
  @@schema("public")
}

model GuestNote {
  id        String   @id @default(cuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  authorId  String?
  bodyEnc   String
  createdAt DateTime @default(now())

  @@index([guestId])
  @@schema("public")
}

model Interaction {
  id        String   @id @default(cuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  channel   String // CALL | SMS | WHATSAPP | EMAIL | NOTE | IMPORT | VISIT (saha ziyareti)
  direction String? // IN | OUT
  refId     String? // Call.id, Message.id …
  summary   String?
  actorId   String?
  at        DateTime @default(now())

  @@index([guestId, at])
  @@schema("public")
}

// ───────────────────────── Kaynak izi ─────────────────────────

model DataSource {
  id        String   @id @default(cuid())
  kind      String // IMPORT | MANUAL | IYS | CASINO | API
  label     String
  createdAt DateTime @default(now())

  @@schema("public")
}

model FieldHistory {
  id            BigInt   @id @default(autoincrement())
  guestId       String
  guest         Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  field         String
  oldValue      String?
  newValue      String?
  sourceId      String?
  importBatchId String?
  actorId       String?
  at            DateTime @default(now())

  @@index([guestId, at])
  @@index([importBatchId])
  @@schema("public")
}

model MergeRecord {
  id         String    @id @default(cuid())
  survivorId String
  mergedId   String
  snapshot   Json // birleşen kaydın birleştirme anındaki tam kopyası (ayırma için)
  actorId    String?
  reason     String?
  at         DateTime  @default(now())
  undoneAt   DateTime?

  @@schema("public")
}

// ───────────────────────── İçe aktarma, karşılaştırma, inceleme ─────────────────────────

enum ImportPurpose {
  NEW_LIST
  UPDATE
  COMPARE

  @@schema("public")
}

enum ImportStatus {
  UPLOADED
  SCANNED
  REJECTED
  MAPPED
  PREVIEWED
  APPLYING
  APPLIED
  ROLLED_BACK
  FAILED

  @@schema("public")
}

model ImportBatch {
  id             String        @id @default(cuid())
  purpose        ImportPurpose
  status         ImportStatus  @default(UPLOADED)
  sourceLabel    String
  fileName       String
  fileSha256     String
  fileSize       Int
  storageKey     String? // şifreli geçici depo; süre dolunca null
  fileExpiresAt  DateTime?
  scanResult     String?
  sheetName      String?
  headers        String[]      @default([])
  mapping        Json?
  matchKey       String? // CRM_ID | EXTERNAL_ID | PHONE_PLUS
  defaultCountry String        @default("TR")
  summary        Json?
  uploadedById   String
  createdAt      DateTime      @default(now())
  appliedAt      DateTime?
  rolledBackAt   DateTime?
  parentId       String? // düzeltme dosyası ise ana batch
  rows           ImportRow[]

  @@schema("public")
}

model ImportRow {
  id         BigInt      @id @default(autoincrement())
  batchId    String
  batch      ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNo      Int
  raw        Json
  normalized Json?
  result     String? // NEW | MATCHED | UNCHANGED | CONFLICT | MULTI_MATCH | INVALID | DUP_IN_FILE
  guestId    String?
  errors     Json?
  decisions  Json? // alan -> KEEP | USE_NEW | REVIEW
  applied    Json? // uygulanan değişiklikler (geri alma için)

  @@index([batchId, rowNo])
  @@index([batchId, result])
  @@schema("public")
}

model MappingTemplate {
  id        String   @id @default(cuid())
  name      String
  partner   String?
  version   Int      @default(1)
  mapping   Json
  createdBy String
  createdAt DateTime @default(now())

  @@unique([name, version])
  @@schema("public")
}

model ReviewItem {
  id         String    @id @default(cuid())
  kind       String // POSSIBLE_DUPLICATE | FIELD_CONFLICT | CONSENT_CONFLICT | MULTI_MATCH | DISPUTED_PHONE
  status     String    @default("OPEN") // OPEN | RESOLVED | DISMISSED
  guestId    String?
  candidates Json
  payload    Json?
  sourceRef  String? // importBatchId / comparisonId / callId
  decision   String?
  decidedBy  String?
  decidedAt  DateTime?
  reason     String?
  createdAt  DateTime  @default(now())

  @@index([status, kind])
  @@schema("public")
}

model ComparisonJob {
  id        String             @id @default(cuid())
  leftRef   String // importBatchId veya "CRM"
  rightRef  String
  key       String
  summary   Json?
  createdBy String
  createdAt DateTime           @default(now())
  results   ComparisonResult[]

  @@schema("public")
}

model ComparisonResult {
  id      BigInt        @id @default(autoincrement())
  jobId   String
  job     ComparisonJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status  String // NEW | SAME | CONTACT_CHANGED | OTHER_CHANGED | MULTI_MATCH | CONFLICT | MISSING_IN_FILE
  guestId String?
  rowNo   Int?
  diff    Json?

  @@index([jobId, status])
  @@schema("public")
}

// ───────────────────────── İzin ve engelleme ─────────────────────────

enum ConsentChannel {
  CALL
  SMS
  WHATSAPP
  EMAIL
  RECORDING

  @@schema("public")
}

enum ConsentStatus {
  GRANTED
  DENIED
  UNKNOWN

  @@schema("public")
}

model ConsentRecord {
  id           String         @id @default(cuid())
  guestId      String
  guest        Guest          @relation(fields: [guestId], references: [id], onDelete: Cascade)
  channel      ConsentChannel
  status       ConsentStatus  @default(UNKNOWN)
  scope        String         @default("MARKETING") // MARKETING | SERVICE
  source       String?
  sourceSystem String?
  proofRef     String?
  grantedAt    DateTime?
  deniedAt     DateTime?
  validUntil   DateTime?
  iysRef       String?
  updatedBy    String?
  updatedAt    DateTime       @updatedAt

  @@unique([guestId, channel])
  @@schema("public")
}

model ConsentHistory {
  id        BigInt   @id @default(autoincrement())
  guestId   String
  channel   String
  oldStatus String?
  newStatus String
  source    String?
  actorId   String?
  at        DateTime @default(now())

  @@index([guestId, at])
  @@schema("public")
}

model ContactBlock {
  id          String    @id @default(cuid())
  guestId     String
  guest       Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  allChannels Boolean   @default(true)
  channel     String?
  reason      String // GUEST_REQUEST | LEGAL | DNC_LIST
  requestedAt DateTime
  recordedAt  DateTime  @default(now())
  recordedBy  String?
  proof       String?
  removedAt   DateTime?
  removedBy   String?

  @@index([guestId])
  @@schema("public")
}

// ───────────────────────── Çağrı merkezi ─────────────────────────

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
  BLOCKED
  EXHAUSTED

  @@schema("public")
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("DRAFT") // DRAFT | ACTIVE | PAUSED | DONE
  maxAttempts Int      @default(5)
  createdBy   String
  createdAt   DateTime @default(now())
  tasks       Task[]

  @@schema("public")
}

model Task {
  id              String     @id @default(cuid())
  type            String     @default("CALL") // CALL | FOLLOW_UP | DOCUMENT | OTHER
  reason          String
  guestId         String
  guest           Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  assigneeId      String?
  assignee        User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  campaignId      String?
  campaign        Campaign?  @relation(fields: [campaignId], references: [id])
  status          TaskStatus @default(OPEN)
  priority        Int        @default(2) // 1 yüksek … 3 düşük
  assignedAt      DateTime   @default(now())
  dueAt           DateTime?
  nextAttemptAt   DateTime?
  attempts        Int        @default(0)
  lastDisposition String?
  closeReason     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  calls           Call[]

  @@index([assigneeId, status])
  @@index([guestId])
  @@index([campaignId])
  @@schema("public")
}

model Disposition {
  code            String  @id // REACHED | NO_ANSWER | …
  labelTr         String
  labelEn         String
  category        String // REACHED | UNREACHED
  countsAsReached Boolean
  noteRequired    Boolean @default(false)
  sortOrder       Int

  @@schema("public")
}

model Call {
  id                  String    @id @default(cuid())
  guestId             String
  guest               Guest     @relation(fields: [guestId], references: [id])
  phoneId             String
  agentId             String
  agent               User      @relation(fields: [agentId], references: [id])
  taskId              String?
  task                Task?     @relation(fields: [taskId], references: [id])
  provider            String    @default("manual")
  externalId          String?
  startedAt           DateTime  @default(now())
  answeredAt          DateTime?
  endedAt             DateTime?
  closedAt            DateTime?
  ringSec             Int?
  talkSec             Int?
  wrapSec             Int?
  disposition         String?
  dispositionSub      String?
  noteEnc             String?
  noteLength          Int       @default(0) // rapor için yalnız uzunluk (içerik şifreli)
  autoClosed          Boolean   @default(false)
  recordingNotice     Boolean?
  recordingPreference String? // ACCEPTED | DECLINED | NOT_ASKED

  @@unique([provider, externalId])
  @@index([agentId, startedAt])
  @@index([guestId, startedAt])
  @@index([taskId])
  @@schema("public")
}

model Callback {
  id           String    @id @default(cuid())
  guestId      String
  guest        Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  assigneeId   String
  assignee     User      @relation("CallbackAssignee", fields: [assigneeId], references: [id])
  scheduledAt  DateTime
  status       String    @default("PENDING") // PENDING | DONE | CANCELLED (DUE/LATE/MISSED hesaplanır)
  sourceCallId String?
  doneCallId   String?
  escalatedAt  DateTime? // gecikince takım liderine görev açıldı
  createdAt    DateTime  @default(now())

  @@index([assigneeId, scheduledAt])
  @@index([guestId])
  @@schema("public")
}

model AgentStatusLog {
  id     BigInt   @id @default(autoincrement())
  userId String
  user   User     @relation(fields: [userId], references: [id])
  status String // READY | BREAK | ON_CALL | WRAP_UP | OFFLINE
  at     DateTime @default(now())

  @@index([userId, at])
  @@schema("public")
}

// ───────────────────────── Santral ─────────────────────────

/**
 * Santral webhook olayları — idempotent işleme için (provider + eventId tekil).
 */
model TelephonyEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  type       String // answered | ended | recording.ready
  callId     String?
  payload    Json
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@schema("public")
}

/**
 * Santral kesintisi / geçersiz webhook / arama başlatma hatası (plan v4 §3).
 */
model TelephonyIncident {
  id         String    @id @default(cuid())
  provider   String
  kind       String // DIAL_FAILED | WEBHOOK_INVALID | WEBHOOK_UNKNOWN_CALL | RECORDING_FETCH_FAILED
  detail     String
  callId     String?
  at         DateTime  @default(now())
  resolvedAt DateTime?

  @@index([at])
  @@schema("public")
}

// ───────────────────────── Ses kaydı ve Türkçe analiz ─────────────────────────
// Karar kapısı (Setting "recording.gate") onaylanmadan kayıt saklanmaz. Analiz yalnız öneridir;
// duygu, kişilik, ikna edilebilirlik, kumar davranışı veya risk/değer skoru alanı YOKTUR.

model Recording {
  id             String      @id @default(cuid())
  callId         String      @unique
  provider       String
  sourceUrlEnc   String? // santral indirme adresi (belirteç içerebilir) — şifreli; indirildikten sonra silinir
  status         String      @default("PENDING_FETCH") // PENDING_FETCH | STORED | FAILED | DISCARDED | DELETED
  discardReason  String? // GATE_CLOSED | GUEST_DECLINED
  storageKey     String?
  channels       Int         @default(1)
  durationSec    Int?
  sizeBytes      Int?
  sha256         String?
  mimeType       String?
  retentionUntil DateTime?
  attempts       Int         @default(0)
  error          String?
  createdAt      DateTime    @default(now())
  storedAt       DateTime?
  deletedAt      DateTime?
  transcript     Transcript?

  @@index([status])
  @@schema("public")
}

model Transcript {
  id            String           @id @default(cuid())
  recordingId   String           @unique
  recording     Recording        @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  callId        String           @unique
  status        String           @default("QUEUED") // QUEUED | PROCESSING | DONE | LOW_CONFIDENCE | FAILED
  language      String?
  model         String?
  modelVersion  String?
  confidence    Float?
  rawEnc        String? // maskelenmemiş konuşma bölütleri (şifreli JSON) — kısa saklama
  rawExpiresAt  DateTime?
  segments      Json? // maskelenmiş bölütler [{speaker, start, end, text}]
  redactedKinds String[]         @default([])
  error         String?
  createdAt     DateTime         @default(now())
  completedAt   DateTime?
  edits         TranscriptEdit[]
  analysis      CallAnalysis?

  @@index([status])
  @@schema("public")
}

model TranscriptEdit {
  id           String     @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  segmentIndex Int
  before       String
  after        String
  editorId     String
  at           DateTime   @default(now())

  @@index([transcriptId])
  @@schema("public")
}

/**
 * Yalnız öneri: özet, konu etiketleri, aksiyon önerileri, süreç uyarıları.
 */
model CallAnalysis {
  id                  String           @id @default(cuid())
  transcriptId        String           @unique
  transcript          Transcript       @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  callId              String           @unique
  summary             String
  topics              String[]
  actions             Json // [{type: CALLBACK|TRANSFER|FOLLOW_UP, at?: ISO, note}]
  processFlags        Json // [{code, message, evidence?}]
  dispositionMismatch Boolean          @default(false)
  model               String
  modelVersion        String
  confidence          Float?
  reviewStatus        String           @default("PENDING") // PENDING | APPROVED | CORRECTED | DISPUTED
  createdAt           DateTime         @default(now())
  reviews             AnalysisReview[]

  @@index([reviewStatus])
  @@schema("public")
}

model AnalysisReview {
  id         String       @id @default(cuid())
  analysisId String
  analysis   CallAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  reviewerId String
  decision   String // APPROVE | CORRECT | DISPUTE
  changes    Json?
  comment    String?
  at         DateTime     @default(now())

  @@index([analysisId])
  @@schema("public")
}

/**
 * Kayıt dinleme izni: gerekçeli ve süreli (varsayılan 24 saat).
 */
model RecordingAccessGrant {
  id        String   @id @default(cuid())
  userId    String
  callId    String
  reason    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, callId])
  @@schema("public")
}

// ───────────────────────── Mesajlaşma (SMS — Aşama 1; WhatsApp Aşama 2) ─────────────────────────

model MessageTemplate {
  id         String    @id @default(cuid())
  name       String
  channel    String    @default("SMS")
  category   String // MARKETING | INFORMATIONAL
  language   String    @default("tr")
  body       String
  status     String    @default("DRAFT") // DRAFT | APPROVED | ARCHIVED
  warnings   String[]  @default([])
  createdBy  String
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@schema("public")
}

model MessageCampaign {
  id             String    @id @default(cuid())
  name           String
  channel        String    @default("SMS")
  category       String // MARKETING | INFORMATIONAL
  templateId     String
  segment        Json // izinli alanlarla filtre: dil, ülke, etiket, son iletişim
  status         String    @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | SENDING | DONE | CANCELLED
  estimate       Json? // hedef, uygun, hariç tutma nedenleri, parça, maliyet
  stats          Json? // gönderildi, başarısız, atlandı
  legalConfirmed Boolean   @default(false)
  preparedBy     String
  submittedAt    DateTime?
  approvedBy     String?
  approvedAt     DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  cancelReason   String?
  createdAt      DateTime  @default(now())

  @@schema("public")
}

model Message {
  id                String    @id @default(cuid())
  campaignId        String?
  guestId           String?
  phoneId           String?
  phoneHash         String?
  channel           String    @default("SMS")
  direction         String // OUT | IN
  templateId        String?
  bodyEnc           String
  segments          Int       @default(1)
  provider          String
  providerMessageId String?
  status            String // QUEUED | SENT | DELIVERED | READ | FAILED | SKIPPED | RECEIVED
  conversationId    String? // WhatsApp ortak gelen kutusu
  waTemplateId      String?
  readAt            DateTime?
  error             String?
  sentById          String?
  isTest            Boolean   @default(false)
  createdAt         DateTime  @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?

  @@unique([provider, providerMessageId])
  @@index([campaignId, status])
  @@index([guestId, createdAt])
  @@schema("public")
}

model OptOutEvent {
  id          String   @id @default(cuid())
  channel     String
  phoneHash   String
  keyword     String
  guestIds    String[] @default([])
  receivedAt  DateTime
  processedAt DateTime @default(now())

  @@schema("public")
}

// ───────────────────────── Ayarlar ─────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@schema("public")
}

// ───────────────────────── Finans (ayrı şema) ─────────────────────────
// Misafire yalnız düz kimlik (guestId + CRM no + ad anlık görüntüsü) ile bağlanır; public şemadan
// finans tablolarına ilişki tanımlanmaz, böylece CRM sorguları finans verisine yanlışlıkla ulaşamaz.

model Casino {
  id          String             @id @default(cuid())
  name        String             @unique
  country     String?
  currency    String             @default("TRY")
  contracts   Contract[]
  trips       Trip[]
  periods     CommissionPeriod[]
  creditLines GuestCreditLine[]
  createdAt   DateTime           @default(now())

  @@schema("finance")
}

/// Casinoya gönderilen oyuncu için ön yatırım (front money) ve kredi hattı — yalnız finans (plan v4 §8).
/// guestId public.Guest.id'dir; şema ayrımı için ilişki tanımlanmaz.
model GuestCreditLine {
  id          String   @id @default(cuid())
  guestId     String
  casinoId    String
  casino      Casino   @relation(fields: [casinoId], references: [id])
  frontMoney  Decimal? @db.Decimal(18, 2)
  creditLimit Decimal? @db.Decimal(18, 2)
  currency    String
  note        String?
  updatedBy   String
  updatedAt   DateTime @updatedAt

  @@unique([guestId, casinoId])
  @@index([casinoId])
  @@schema("finance")
}

model Contract {
  id        String            @id @default(cuid())
  casinoId  String
  casino    Casino            @relation(fields: [casinoId], references: [id])
  name      String
  versions  ContractVersion[]
  createdAt DateTime          @default(now())

  @@index([casinoId])
  @@schema("finance")
}

model ContractVersion {
  id         String    @id @default(cuid())
  contractId String
  contract   Contract  @relation(fields: [contractId], references: [id])
  version    Int
  validFrom  DateTime
  validTo    DateTime?
  combine    String    @default("SUM") // SUM | MAX | PRIORITY
  rules      Json // CommissionRule bileşenleri (docs/06 §4)
  note       String?
  createdBy  String
  createdAt  DateTime  @default(now())

  @@unique([contractId, version])
  @@schema("finance")
}

model Trip {
  id        String      @id @default(cuid())
  casinoId  String
  casino    Casino      @relation(fields: [casinoId], references: [id])
  name      String
  startDate DateTime
  endDate   DateTime
  status    String      @default("PLANNED") // PLANNED | DONE | CANCELLED
  createdBy String
  createdAt DateTime    @default(now())
  guests    TripGuest[]

  @@index([casinoId])
  @@schema("finance")
}

model TripGuest {
  id        String           @id @default(cuid())
  tripId    String
  trip      Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  guestId   String // public.Guest.id (ilişki tanımlanmaz)
  crmNo     Int
  guestName String // eklendiği anki ad (anlık görüntü)
  country   String? // eklendiği anki ülke (ülke bazlı kurallar için anlık görüntü)
  results   GamingResult[]
  travel    TripGuestTravel?

  @@unique([tripId, guestId])
  @@schema("finance")
}

model GamingResult {
  id          String           @id @default(cuid())
  tripGuestId String
  tripGuest   TripGuest        @relation(fields: [tripGuestId], references: [id])
  periodId    String
  period      CommissionPeriod @relation(fields: [periodId], references: [id])
  playedOn    DateTime
  buyIn       Decimal?         @db.Decimal(18, 2)
  cashOut     Decimal?         @db.Decimal(18, 2)
  rolling     Decimal?         @db.Decimal(18, 2)
  netLoss     Decimal          @db.Decimal(18, 2) // pozitif = misafir kaybı, negatif = misafir kazancı
  currency    String
  source      String           @default("MANUAL") // MANUAL | IMPORT | STATEMENT
  sourceRef   String?
  enteredBy   String
  enteredAt   DateTime         @default(now())

  @@index([periodId])
  @@index([tripGuestId])
  @@schema("finance")
}

model CommissionPeriod {
  id           String                  @id @default(cuid())
  casinoId     String
  casino       Casino                  @relation(fields: [casinoId], references: [id])
  period       String // "2026-11"
  status       String                  @default("OPEN") // OPEN | LOCKED
  lockedAt     DateTime?
  lockedBy     String?
  calculations CommissionCalculation[]
  results      GamingResult[]
  adjustments  CommissionAdjustment[]

  @@unique([casinoId, period])
  @@schema("finance")
}

model CommissionCalculation {
  id               String                 @id @default(cuid())
  periodId         String
  period           CommissionPeriod       @relation(fields: [periodId], references: [id])
  version          Int                    @default(1)
  status           String                 @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | RECONCILED | CANCELLED
  amount           Decimal                @db.Decimal(18, 2)
  currency         String
  snapshot         Json // kullanılan sözleşme sürümü ve kurallar, girdi sonuçları ve toplamlar, hesap notu
  note             String?
  preparedBy       String
  submittedAt      DateTime?
  approvedBy       String?
  approvedAt       DateTime?
  rejectReason     String?
  statementRef     String?
  method           String                 @default("MANUAL") // MANUAL | ENGINE (Aşama 3: motor sonucu kabul edildi)
  engineAmount     Decimal?               @db.Decimal(18, 2) // gölge mod: aynı anda hesaplanan motor tutarı
  statementId      String?
  reconcileSummary Json? // ekstre ↔ girilen sonuç ↔ hesap farkları
  reconciledBy     String?
  reconciledAt     DateTime?
  cancelReason     String?
  createdAt        DateTime               @default(now())
  adjustments      CommissionAdjustment[]

  @@index([periodId])
  @@schema("finance")
}

/**
 * Kilitli döneme ait düzeltme: açık bir sonraki dönemde yeni kayıt olarak işlenir (docs/06 §6).
 */
model CommissionAdjustment {
  id            String                @id @default(cuid())
  calculationId String
  calculation   CommissionCalculation @relation(fields: [calculationId], references: [id])
  periodId      String // düzeltmenin işlendiği (açık) dönem
  period        CommissionPeriod      @relation(fields: [periodId], references: [id])
  amount        Decimal               @db.Decimal(18, 2) // + veya −
  currency      String
  reason        String
  status        String                @default("DRAFT") // DRAFT | APPROVED | CANCELLED
  preparedBy    String
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime              @default(now())

  @@index([calculationId])
  @@index([periodId])
  @@schema("finance")
}

// ───────────────────────── Personel ve puantaj (ayrı şema, Aşama 1B) ─────────────────────────
// public şemasına ilişki tanımlanmaz (userId / teamId düz alan); CRM sorguları personel verisine ulaşamaz.
// Sağlık/teşhis bilgisi tutulmaz (docs/11 §4). Saatler Europe/Istanbul (+03:00) takvim gününe göredir.

model Employee {
  id             String     @id @default(cuid())
  sicilNo        String     @unique
  firstName      String
  lastName       String
  department     String // CALL_CENTER | FIELD | OFFICE | FINANCE | MANAGEMENT
  title          String?
  teamId         String? // public.Team.id (düz alan)
  managerId      String?
  manager        Employee?  @relation("EmployeeManager", fields: [managerId], references: [id])
  reports        Employee[] @relation("EmployeeManager")
  employmentType String     @default("FULL") // FULL | PART
  weeklyHours    Int        @default(45)
  hireDate       DateTime   @db.Date
  exitDate       DateTime?  @db.Date
  status         String     @default("ACTIVE") // ACTIVE | EXITED
  userId         String?    @unique // CRM kullanıcısıysa public.User.id
  phoneEnc       String?
  emailEnc       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  assignments RosterAssignment[]
  routes      FieldRoute[]
  leaves      LeaveRequest[]
  days        AttendanceDay[]

  @@index([teamId])
  @@schema("hr")
}

model ShiftTemplate {
  id       String  @id @default(cuid())
  name     String  @unique
  startMin Int // gece yarısından dakika
  endMin   Int // startMin'den küçükse ertesi güne devreder
  breakMin Int     @default(60)
  color    String  @default("#1FA29A")
  active   Boolean @default(true)

  @@schema("hr")
}

model Roster {
  id              String             @id @default(cuid())
  weekStart       DateTime           @db.Date // Pazartesi
  scope           String // ekip kimliği veya "GENEL"
  status          String             @default("DRAFT") // DRAFT | PUBLISHED | CHANGED
  version         Int                @default(0)
  publishedAt     DateTime?
  publishedBy     String?
  prevPublishedAt DateTime?
  overrideReason  String?
  createdBy       String
  createdAt       DateTime           @default(now())
  assignments     RosterAssignment[]

  @@unique([weekStart, scope])
  @@schema("hr")
}

model RosterAssignment {
  id         String   @id @default(cuid())
  rosterId   String
  roster     Roster   @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       DateTime @db.Date
  kind       String // WORK | OFF | LEAVE | TRAINING | FIELD
  templateId String?
  startMin   Int?
  endMin     Int?
  breakMin   Int?
  note       String?
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([rosterId])
  @@schema("hr")
}

model Location {
  id      String      @id @default(cuid())
  name    String      @unique
  kind    String // CASINO | HOTEL | AIRPORT | OFFICE | OTHER
  city    String?
  address String?
  active  Boolean     @default(true)
  stops   RouteStop[]

  @@schema("hr")
}

model FieldRoute {
  id          String      @id @default(cuid())
  employeeId  String
  employee    Employee    @relation(fields: [employeeId], references: [id])
  weekStart   DateTime    @db.Date
  status      String      @default("DRAFT") // DRAFT | PUBLISHED
  createdBy   String
  publishedAt DateTime?
  stops       RouteStop[]

  @@unique([employeeId, weekStart])
  @@schema("hr")
}

model RouteStop {
  id         String     @id @default(cuid())
  routeId    String
  route      FieldRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  date       DateTime   @db.Date
  seq        Int
  plannedMin Int?
  locationId String
  location   Location   @relation(fields: [locationId], references: [id])
  purpose    String
  guestId    String? // public.Guest.id (düz alan; finans yok)
  guestName  String? // rotada yalnız ad görünür
  status     String     @default("PLANNED") // PLANNED | DONE | SKIPPED | CANCELLED
  checkInAt  DateTime?
  checkOutAt DateTime?
  resultNote String?

  @@index([routeId, date])
  @@schema("hr")
}

model LeaveType {
  id            String         @id @default(cuid())
  code          String         @unique // İ | R | Ü | M | İD
  name          String
  paid          Boolean        @default(true)
  needsDocument Boolean        @default(false)
  requests      LeaveRequest[]

  @@schema("hr")
}

model LeaveRequest {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  typeId        String
  type          LeaveType @relation(fields: [typeId], references: [id])
  startDate     DateTime  @db.Date
  endDate       DateTime  @db.Date
  halfDay       Boolean   @default(false)
  status        String    @default("REQUESTED") // REQUESTED | PRE_APPROVED | APPROVED | REJECTED | CANCELLED
  note          String?
  documentRef   String? // belge referansı (teşhis/sağlık bilgisi yazılmaz)
  requestedBy   String
  preApprovedBy String?
  approvedBy    String?
  decidedAt     DateTime?
  rejectReason  String?
  createdAt     DateTime  @default(now())

  @@index([employeeId, startDate])
  @@schema("hr")
}

model PublicHoliday {
  id      String   @id @default(cuid())
  date    DateTime @unique @db.Date
  name    String
  halfDay Boolean  @default(false) // arife: 13:00'ten sonrası tatil

  @@schema("hr")
}

model AttendanceDay {
  id             String                 @id @default(cuid())
  employeeId     String
  employee       Employee               @relation(fields: [employeeId], references: [id])
  date           DateTime               @db.Date
  planStart      DateTime?
  planEnd        DateTime?
  firstIn        DateTime?
  lastOut        DateTime?
  workedMin      Int                    @default(0)
  breakMin       Int                    @default(0)
  lateMin        Int                    @default(0)
  earlyMin       Int                    @default(0)
  overtimeMin    Int                    @default(0)
  holidayWorkMin Int                    @default(0)
  code           String                 @default("")
  source         String                 @default("SYSTEM") // SYSTEM | FIELD | MANUAL
  flags          String[]               @default([])
  adjusted       Boolean                @default(false)
  computedAt     DateTime               @default(now())
  adjustments    AttendanceAdjustment[]

  @@unique([employeeId, date])
  @@index([date])
  @@schema("hr")
}

/**
 * Puantaj düzeltmeleri değiştirilemez (DB tetikleyicisi).
 */
model AttendanceAdjustment {
  id       String        @id @default(cuid())
  dayId    String
  day      AttendanceDay @relation(fields: [dayId], references: [id])
  field    String // firstIn | lastOut | breakMin | code
  oldValue String?
  newValue String
  reason   String
  actorId  String
  at       DateTime      @default(now())

  @@index([dayId])
  @@schema("hr")
}

model TimesheetPeriod {
  id         String    @id @default(cuid())
  month      String // YYYY-MM
  scope      String // ekip kimliği veya "GENEL"
  status     String    @default("OPEN") // OPEN | IN_REVIEW | APPROVED | LOCKED
  preparedBy String?
  preparedAt DateTime?
  approvedBy String?
  approvedAt DateTime?
  lockedAt   DateTime?
  note       String?

  @@unique([month, scope])
  @@schema("hr")
}

// ───────────────────────── Aşama 2: kurum sözlüğü ve kalite örneklemesi ─────────────────────────

/**
 * Türkçe kurum sözlüğü: transkriptte casino/otel/kişi adlarının doğru tanınması için ilk istem.
 */
model VocabularyTerm {
  id        String   @id @default(cuid())
  term      String   @unique
  kind      String // CASINO | HOTEL | PERSON | PLACE | OTHER
  active    Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())

  @@schema("public")
}

/**
 * Ortak kriter seti (sürümlü). Kriterler yalnız “karşılandı / karşılanmadı / uygulanmaz” alır; puan yoktur.
 */
model QaCriteriaSet {
  id        String     @id @default(cuid())
  name      String
  version   Int
  criteria  Json // [{key, label, description}]
  active    Boolean    @default(true)
  createdBy String
  createdAt DateTime   @default(now())
  reviews   QaReview[]

  @@unique([name, version])
  @@schema("public")
}

/**
 * Kalite örneklemi: rastgele örneklem + analizin önerdiği adaylar (süreç uyarısı, uyuşmazlık, düşük güven).
 * Örneklem puan, sıralama veya yaptırım üretmez; koçluk içindir ve personelin açıklama/itiraz hakkı vardır.
 */
model QaSample {
  id               String     @id @default(cuid())
  callId           String     @unique
  agentId          String
  teamId           String?
  reason           String // RANDOM | PROCESS_FLAG | MISMATCH | LOW_CONFIDENCE | MANUAL
  weekStart        DateTime   @db.Date
  status           String     @default("OPEN") // OPEN | REVIEWED | ACKNOWLEDGED | DISPUTED | CLOSED
  agentComment     String?
  agentRespondedAt DateTime?
  resolution       String?
  closedBy         String?
  closedAt         DateTime?
  createdAt        DateTime   @default(now())
  reviews          QaReview[]

  @@index([teamId, status])
  @@index([agentId, status])
  @@schema("public")
}

model QaReview {
  id            String        @id @default(cuid())
  sampleId      String
  sample        QaSample      @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  criteriaSetId String
  criteriaSet   QaCriteriaSet @relation(fields: [criteriaSetId], references: [id])
  reviewerId    String
  results       Json // [{key, result: MET | NOT_MET | NA, note?}]
  coachingNote  String
  at            DateTime      @default(now())

  @@index([sampleId])
  @@schema("public")
}

// ───────────────────────── Aşama 2: WhatsApp Business (resmi API) ─────────────────────────
// Kişisel hesap otomasyonu yoktur. Pencere dışında yalnız Meta'da onaylı şablon gönderilir (docs/10).

/**
 * Onaylı şablon kataloğu: kategori, dil, sürüm, Meta onay durumu. Sürüm değişikliği yeni kayıttır.
 */
model WaTemplate {
  id                 String    @id @default(cuid())
  name               String // Meta şablon adı (küçük harf, alt çizgi)
  language           String    @default("tr")
  category           String // MARKETING | UTILITY
  body               String // {{1}} {{2}} … Meta biçimi; değişken anlamları `variables`
  variables          String[]  @default([]) // ör. ["ad", "temsilci_adi"] — beyaz liste
  optOutButton       Boolean   @default(false) // pazarlamada “Aboneliği iptal et” hızlı yanıtı zorunlu
  version            Int       @default(1)
  metaStatus         String    @default("DRAFT") // DRAFT | PENDING | APPROVED | REJECTED | PAUSED
  internalApprovedBy String?
  createdBy          String
  createdAt          DateTime  @default(now())
  statusAt           DateTime?

  @@unique([name, language, version])
  @@schema("public")
}

/**
 * Ortak gelen kutusu konuşması: numara (blind index) başına bir açık konuşma; atama ve kapanış.
 */
model Conversation {
  id             String    @id @default(cuid())
  channel        String    @default("WHATSAPP")
  phoneHash      String
  phoneEnc       String
  guestId        String?
  assigneeId     String?
  teamId         String?
  status         String    @default("OPEN") // OPEN | CLOSED
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  unread         Int       @default(0)
  optOutSuspect  Boolean   @default(false) // belirsiz ret ifadesi → en üste
  createdAt      DateTime  @default(now())
  closedAt       DateTime?

  @@index([status, assigneeId])
  @@index([phoneHash])
  @@schema("public")
}

// ───────────────────────── Aşama 2: İYS ─────────────────────────

/**
 * İYS sorgu izi: hangi numara, hangi tür, hangi sonuç, hangi kaynak (docs/04 §6). Sonuç kısa süre önbelleklenir.
 */
model IysQueryLog {
  id        String   @id @default(cuid())
  phoneHash String
  type      String // MESAJ | ARAMA
  result    String // ONAY | RET | UNAVAILABLE
  source    String // none | http | mock
  at        DateTime @default(now())

  @@index([phoneHash, type, at])
  @@schema("public")
}

/**
 * İYS'ye bildirilecek retler: durdurma kaydında TR numaraları için kuyruğa girer, işçi gönderir.
 */
model IysOutbox {
  id        String    @id @default(cuid())
  phoneHash String
  phoneEnc  String
  type      String // MESAJ | ARAMA
  guestId   String
  blockId   String
  status    String    @default("PENDING") // PENDING | SENT | FAILED
  attempts  Int       @default(0)
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
  @@schema("public")
}

// ───────────────────────── Aşama 3: casino ekstresi ve mutabakat ─────────────────────────

/**
 * Casino ekstresi: kaynak dosya şifreli saklanır, özeti (SHA-256) değişmezliği kanıtlar.
 */
model CasinoStatement {
  id         String          @id @default(cuid())
  casinoId   String
  period     String // "2026-11"
  fileName   String
  sha256     String
  storageKey String?
  currency   String
  status     String          @default("IMPORTED") // IMPORTED | APPLIED | SUPERSEDED
  totals     Json // {netLoss, rolling, lines, matched, unmatched}
  uploadedBy String
  uploadedAt DateTime        @default(now())
  appliedBy  String?
  appliedAt  DateTime?
  lines      StatementLine[]

  @@index([casinoId, period])
  @@schema("finance")
}

model StatementLine {
  id          String          @id @default(cuid())
  statementId String
  statement   CasinoStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  rowNo       Int
  crmNo       Int?
  playerRef   String? // casino oyuncu no
  name        String?
  playedOn    DateTime?
  netLoss     Decimal         @db.Decimal(18, 2)
  rolling     Decimal?        @db.Decimal(18, 2)
  tripGuestId String?
  match       String // MATCHED | UNMATCHED | NOT_IN_TRIP | INVALID
  issue       String?
  resultId    String? // uygulandıysa oluşan GamingResult

  @@index([statementId])
  @@schema("finance")
}

// ───────────── Casino müşteri profili (casinoya gönderilen oyuncunun tüm bilgileri; yalnız sistem içinde) ─────────────

/// Kimlik ve casino tercihleri. Kimlik numaraları ve adres alan şifreli; arama için kör indeks (hash).
/// Kimlik alanlarını yalnız field.identity yetkisi görür ve her görüntüleme erişim kaydına yazılır.
model GuestProfile {
  guestId         String    @id
  guest           Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  nationality     String? // ISO-3166 alfa-2
  gender          String? // F | M | X
  birthDate       DateTime? @db.Date
  tcNoEnc         String?
  tcNoHash        String?
  passportNoEnc   String?
  passportNoHash  String?
  passportCountry String?
  passportExpiry  DateTime? @db.Date
  addressEnc      String?
  games           String[]  @default([]) // BACCARAT | ROULETTE | BLACKJACK | POKER | SLOT | OTHER
  tableMin        Int?
  tableMax        Int?
  limitCurrency   String?
  hostUserId      String?
  preferences     String? // oda, yemek, sigara, özel istekler (sağlık bilgisi yazılmaz)
  updatedBy       String?
  updatedAt       DateTime  @updatedAt

  @@index([tcNoHash])
  @@index([passportNoHash])
  @@schema("public")
}

/// Kimlik/pasaport görüntüsü ve vesikalık: virüs taramalı, şifreli dosya; görüntüleme gerekçeli ve kayıtlı.
model GuestDocument {
  id         String    @id @default(cuid())
  guestId    String
  guest      Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  kind       String // PASSPORT | ID_CARD | PHOTO | VISA | OTHER
  fileName   String
  mime       String
  size       Int
  sha256     String
  storageKey String
  scanResult String
  uploadedBy String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  deletedBy  String?

  @@index([guestId])
  @@schema("public")
}

/// Trip katılımcısının seyahat bilgisi (uçuş, otel, transfer). Tutar içermez.
model TripGuestTravel {
  tripGuestId String    @id
  tripGuest   TripGuest @relation(fields: [tripGuestId], references: [id], onDelete: Cascade)
  outFlight   String?
  outAt       DateTime?
  outRoute    String?
  retFlight   String?
  retAt       DateTime?
  retRoute    String?
  pnr         String?
  hotel       String?
  roomType    String?
  checkIn     DateTime? @db.Date
  checkOut    DateTime? @db.Date
  transfer    String?
  companion   String?
  note        String?
  updatedBy   String
  updatedAt   DateTime  @updatedAt

  @@schema("finance")
}
