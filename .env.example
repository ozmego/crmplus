# Veritabanı ve kuyruk
DATABASE_URL="postgresql://crmplus:crmplus_dev@localhost:25433/crmplus?schema=public"
REDIS_URL="redis://localhost:16380"

# Alan şifreleme (AES-256-GCM) ve arama özeti (HMAC-SHA256) anahtarları.
# Her biri 32 bayt, base64. Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=""
BLIND_INDEX_KEY=""

# Oturum
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Telefon normalizasyonunda varsayılan ülke
DEFAULT_PHONE_COUNTRY=TR

# İlk süper yönetici (yalnız seed sırasında kullanılır)
SEED_ADMIN_EMAIL="admin@crmplus.local"
SEED_ADMIN_PASSWORD=""

# Santral (Aşama 1): manual | pbx-http
PBX_PROVIDER=manual
PBX_DIAL_URL=
PBX_API_TOKEN=
# 32 bayt hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PBX_WEBHOOK_SECRET=

# Transkript motoru: remote (şirket içi faster-whisper servisi) | mock (yalnız geliştirme)
TRANSCRIBER=
SPEECH_URL=
SPEECH_TOKEN=
# Yerel dil modeli (isteğe bağlı)
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:14b-instruct

# ClamAV (üretimde zorunlu)
CLAMAV_HOST=
CLAMAV_PORT=3310

# Bu satır sayısının üstündeki içe aktarmalar arka plan işçisinde çalışır
IMPORT_INLINE_MAX_ROWS=5000

# SMS (docs/10) — SMS_PROVIDER: sms-http (üretim) | mock (yalnız geliştirme)
SMS_PROVIDER=
SMS_SEND_URL=
SMS_API_TOKEN=
SMS_SENDER=
SMS_OPT_OUT_TEXT=
SMS_WEBHOOK_SECRET=
SMS_TPS=10
SMS_UNIT_COST=0.2

# WhatsApp Business (docs/10) — WA_PROVIDER: meta-cloud (üretim) | mock (yalnız geliştirme)
WA_PROVIDER=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v21.0

# İYS (docs/04 §6) — IYS_PROVIDER: none (bağlı değil, TR numaralara ileti gitmez) | http | mock (yalnız geliştirme)
IYS_PROVIDER=none
IYS_URL=
IYS_TOKEN=
IYS_BRAND_CODE=

# Telefon doğrulama (plan v4 §2) — PHONE_CHECK_PROVIDER: none | http | mock (yalnız geliştirme)
PHONE_CHECK_PROVIDER=none
PHONE_CHECK_URL=
PHONE_CHECK_TOKEN=
