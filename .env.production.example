# crmPlus üretim ayarları (docs/12). Bu dosyayı kopyalamak yerine `scripts/init-env.sh` ile üretin:
# rastgele parolaları ve anahtarları kendisi oluşturur. Dosyayı sürüm kontrolüne EKLEMEYİN.
#
# ⚠ FIELD_ENCRYPTION_KEY ve BLIND_INDEX_KEY kaybolursa şifreli alanlar (telefon, e-posta, notlar, ses) OKUNAMAZ.
#   Yedeklerden ayrı, güvenli bir yerde (kasa / parola yöneticisi) saklayın.

# ─── Alan adı ve TLS ───
CRMPLUS_DOMAIN=crm.sirket.local
# İnternete açık: ACME e-postası (ör. bt@sirket.com.tr). İç ağ: internal
CRMPLUS_TLS=internal

# ─── Veritabanı ve kuyruk (compose içi; DATABASE_URL/REDIS_URL compose tarafından üretilir) ───
POSTGRES_DB=crmplus
POSTGRES_USER=crmplus
POSTGRES_PASSWORD=__RANDOM_HEX_32__
REDIS_PASSWORD=__RANDOM_HEX_32__

# ─── Şifreleme anahtarları (32 bayt, base64) ───
FIELD_ENCRYPTION_KEY=__RANDOM_B64_32__
BLIND_INDEX_KEY=__RANDOM_B64_32__

# ─── Oturum ───
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
DEFAULT_PHONE_COUNTRY=TR

# ─── İlk yönetici (yalnız ilk kurulumdaki seed için; ilk girişte şifre değişimi + MFA zorunlu) ───
SEED_ADMIN_EMAIL=admin@sirket.com.tr
SEED_ADMIN_PASSWORD=__RANDOM_HEX_16__

# ─── Giriş politikası ───
# İki adımlı doğrulama (TOTP). Şirket kararıyla kapalı; kişisel ve finansal veri için açılması önerilir (docs/12 §8).
AUTH_MFA_REQUIRED=false
PASSWORD_MIN_LENGTH=8

# ─── Dosya tarama (compose içi ClamAV) ───
IMPORT_INLINE_MAX_ROWS=5000

# ─── Santral: 3cx (3CX V20) | pbx-http (genel bulut santral) | manual (yedek) ───
PBX_PROVIDER=manual
PBX_DIAL_URL=
PBX_API_TOKEN=
PBX_WEBHOOK_SECRET=__RANDOM_HEX_32__
# 3CX: Yönetim konsolu > Entegrasyonlar > API (docs/12 §3a)
THREECX_URL=
THREECX_CLIENT_ID=
THREECX_CLIENT_SECRET=
THREECX_DIAL_FORMAT=e164

# ─── Ses / transkript: remote (speech profili) | boş = kayıt analizi kapalı ───
# Karar kapısı Ayarlar ekranından onaylanmadan kayıt saklanmaz (docs/09).
TRANSCRIBER=
SPEECH_URL=http://speech:8000
SPEECH_TOKEN=__RANDOM_HEX_32__
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:14b-instruct

# ─── SMS: sms-http | boş = kapalı ───
SMS_PROVIDER=
SMS_SEND_URL=
SMS_API_TOKEN=
SMS_SENDER=
SMS_OPT_OUT_TEXT=
SMS_WEBHOOK_SECRET=__RANDOM_HEX_32__
SMS_TPS=10
SMS_UNIT_COST=0.2

# ─── WhatsApp: meta-cloud | boş = kapalı (ayrıca KVKK aktarım kapısı gerekir) ───
WA_PROVIDER=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=__RANDOM_HEX_16__
WA_GRAPH_VERSION=v21.0
WA_TPS=10
WA_UNIT_COST=0.6

# ─── İYS: none (TR numaralara ileti gitmez) | http ───
IYS_PROVIDER=none
IYS_URL=
IYS_TOKEN=
IYS_BRAND_CODE=

# ─── Telefon doğrulama: none | http ───
PHONE_CHECK_PROVIDER=none
PHONE_CHECK_URL=
PHONE_CHECK_TOKEN=
